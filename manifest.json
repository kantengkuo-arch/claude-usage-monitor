{
  "manifest_version": 3,
  "name": "Claude Usage Monitor",
  "version": "2.0.0",
  "description": "Polls your Claude.ai plan usage in the background and shows it on the toolbar badge. Auto-refreshes.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Usage",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
